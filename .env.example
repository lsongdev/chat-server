CHAT_BASE_URL=https://chat.lsong.org
HTTP_ADDR=:8081
CHAT_BACKEND=http://127.0.0.1:8081
CHAT_FRONTEND_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://chat:replace-with-a-long-random-password@127.0.0.1:5432/chat?sslmode=disable

OIDC_ISSUER=https://my.lsong.org
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=https://chat.lsong.org/auth/callback
MOBILE_AUTH_CALLBACK=flame://auth/callback

SESSION_TTL=24h
ALLOWED_ORIGINS=https://chat.lsong.org,http://localhost:8080
MAX_MESSAGE_BYTES=8192
MAX_CONVERSATION_MEMBERS=1000
TRUST_PROXY_HEADERS=true
